# Cloudflare Workers (static assets) / Cloudflare Pages / Netlify. Vercel usa vercel.json com o mesmo conteúdo.
# A Content-Security-Policy é emitida pelo Astro como <meta http-equiv> (ver astro.config.mjs).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
  # A CSP em <meta> não governa Web Workers; o cabeçalho abaixo vale para os scripts dos workers.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; worker-src 'self'; object-src 'none'
