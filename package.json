{
  "name": "brpdf",
  "private": true,
  "version": "0.2.0",
  "description": "Preparador de PDFs para peticionamento eletrônico: compacta e divide PDFs no navegador para caberem no limite do tribunal.",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate:rules && astro build",
    "preview": "astro preview",
    "preview:cf": "npm run build && npx wrangler@4 dev --port 8788",
    "deploy": "npm run build && npx wrangler@4 deploy",
    "check": "astro check && npm run check:worker",
    "check:worker": "tsc -p src/worker/tsconfig.json",
    "typecheck": "astro check && npm run check:worker",
    "validate:rules": "node scripts/validate-rules.mjs",
    "check:sources": "node scripts/check-sources.mjs",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:navegadores": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter": "^5.3.0",
    "@jspawn/ghostscript-wasm": "0.0.2",
    "asn1js": "^3.0.10",
    "astro": "^7.3.2",
    "fflate": "^0.8.2",
    "pdf-lib": "^1.17.1",
    "pkijs": "^3.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@cloudflare/workers-types": "^5.20260914.1",
    "@playwright/test": "1.56.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
