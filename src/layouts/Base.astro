---
import { SITE } from '../config/site'
import '@fontsource/inter/latin-400.css'
import '@fontsource/inter/latin-500.css'
import '@fontsource/inter/latin-600.css'
import '@fontsource/inter/latin-700.css'
import '@fontsource/inter/latin-800.css'
import '@fontsource/inter/latin-ext-400.css'
import '@fontsource/inter/latin-ext-500.css'
import '@fontsource/inter/latin-ext-600.css'
import '@fontsource/inter/latin-ext-700.css'
import '@fontsource/inter/latin-ext-800.css'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** Caminho canônico começando com /, ex.: /guias/ */
  path?: string
  noindex?: boolean
}
const { title, description, path = Astro.url.pathname, noindex = false } = Astro.props
const canonical = new URL(path, SITE.url).href
const fullTitle = path === '/' ? `${SITE.name} — ${title}` : `${title} · ${SITE.name}`
const current = (p: string) => (path === p || (p !== '/' && path.startsWith(p)) ? 'page' : undefined)
const LINKS = [
  { href: '/?view=tool', label: 'Compactar PDF', match: undefined, tool: true },
  { href: '/tribunais/', label: 'Limites por tribunal', match: '/tribunais/' },
  { href: '/#ferramentas', label: 'Ferramentas', match: undefined, home: true },
  { href: '/#seguranca', label: 'Segurança', match: undefined, home: true },
]
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101f3d" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href="/" aria-label={`${SITE.name} — página inicial`}>
          <span class="logo" aria-hidden="true">br</span>
          <span class="brand-text">
            <span class="brand-name">{SITE.name}</span>
            <span class="brand-sub">PDF Jurídico</span>
          </span>
        </a>
        <nav class="site-nav" aria-label="Principal">
          {LINKS.map((l) => (
            <a
              href={l.href}
              aria-current={l.match ? current(l.match) : undefined}
              data-open-tool={l.tool ? '' : undefined}
              data-go-home={l.home ? '' : undefined}
            >
              {l.label}
            </a>
          ))}
        </nav>
        <a class="btn header-cta" href="/?view=tool" data-open-tool>Preparar PDFs</a>
        <details class="nav-toggle">
          <summary aria-label="Abrir o menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </summary>
          <nav class="panel" aria-label="Menu">
            {LINKS.map((l) => (
              <a
                href={l.href}
                aria-current={l.match ? current(l.match) : undefined}
                data-open-tool={l.tool ? '' : undefined}
                data-go-home={l.home ? '' : undefined}
              >
                {l.label}
              </a>
            ))}
          </nav>
        </details>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="inner">
        <nav aria-label="Rodapé">
          <a href="/privacidade/">Privacidade</a>
          <a href="/termos/">Termos de uso</a>
          <a href="/metodologia/">Metodologia</a>
          <a href="/contato/">Contato</a>
        </nav>
        <p>
          O {SITE.name} é gratuito, independente e não possui vínculo com tribunais ou com o CNJ. Confira sempre o limite informado no sistema de
          peticionamento.
        </p>
        <p>
          Software livre AGPL-3.0. <a href="https://www.ghostscript.com/" rel="noreferrer noopener" target="_blank">Ghostscript</a> executado em
          WebAssembly no navegador.
        </p>
      </div>
    </footer>
  </body>
</html>
