---
import { SITE } from '../config/site'
import LOGO from '../../public/brpdf-logo.svg?raw'
import '@fontsource/inter/latin-400.css'
import '@fontsource/inter/latin-500.css'
import '@fontsource/inter/latin-600.css'
import '@fontsource/inter/latin-700.css'
import '@fontsource/inter/latin-800.css'
import '@fontsource/inter/latin-ext-400.css'
import '@fontsource/inter/latin-ext-500.css'
import '@fontsource/inter/latin-ext-600.css'
import '@fontsource/inter/latin-ext-700.css'
import '@fontsource/inter/latin-ext-800.css'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** Caminho canônico começando com /, ex.: /guias/ */
  path?: string
  noindex?: boolean
}
const { title, description, path = Astro.url.pathname, noindex = false } = Astro.props
const canonical = new URL(path, SITE.url).href
const fullTitle = path === '/' ? `${SITE.name} — ${title}` : `${title} · ${SITE.name}`
const current = (p: string) => (path === p || (p !== '/' && path.startsWith(p)) ? 'page' : undefined)
interface NavLink {
  href: string
  label: string
  /** Caminho que marca o item como página atual */
  match?: string
  /** Abre a ferramenta sem recarregar; o valor vira a "origem" na medição */
  tool?: string
  /**
   * Volta à página inicial e rola até a âncora do próprio link.
   *
   * Sem uso na barra desde que "Ferramentas" saiu (ver o comentário abaixo de LINKS). O mecanismo
   * fica: é genérico, custa um atributo, e a alternativa seria arrancar o tratador em App.tsx que
   * pode voltar a ser preciso na próxima âncora.
   */
  home?: boolean
}
/*
 * A barra leva as DUAS ferramentas prontas, não só uma.
 *
 * Verificar assinatura é a única coisa aqui que resolve um problema urgente e pontual — quem chega
 * com essa dúvida não está navegando, está com um arquivo na mão e um prazo. Deixar isso a três
 * cliques (rodapé ou grade da home) é esconder a porta de entrada de maior intenção do site.
 *
 * Rótulo em "verificar", e não "conferir": é a palavra que as pessoas digitam. O veredito da
 * ferramenta continua em "confere" — ver o comentário em src/pages/conferir-assinatura.astro.
 */
const LINKS: NavLink[] = [
  { href: '/?view=tool', label: 'Compactar PDF', tool: 'menu' },
  { href: '/verificar-assinatura-digital/', label: 'Verificar assinatura', match: '/verificar-assinatura-digital/' },
  { href: '/metadados-pdf/', label: 'Raio-X do PDF', match: '/metadados-pdf/' },
  { href: '/documento-feito-por-ia/', label: 'Feito por IA?', match: '/documento-feito-por-ia/' },
  { href: '/tribunais/', label: 'Limites por tribunal', match: '/tribunais/' },
]

/*
 * "Ferramentas" saiu da barra quando a quarta ferramenta entrou.
 *
 * Era uma âncora para a grade da página inicial — uma lista das mesmas ferramentas que hoje estão
 * na própria barra. Deixar as duas coisas custava ~120 px de uma linha que já não fechava em
 * largura nenhuma (medido: 850 px só de navegação, estourando de 920 a 1600 px), e o que se ganhava
 * era um link para uma lista do que está ao lado dele.
 *
 * Sai um atalho, não um destino: a grade continua na home, com as ferramentas futuras, e o rodapé
 * lista todas em todas as páginas.
 */
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#2e2e2e" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {SITE.verificacao.google && <meta name="google-site-verification" content={SITE.verificacao.google} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    {/* Sem isto, link compartilhado no WhatsApp ou no LinkedIn aparece sem prévia nenhuma. */}
    <meta property="og:image" content={new URL('/og.png', SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${SITE.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', SITE.url).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href="/" aria-label={`${SITE.name} — página inicial`}>
          {/*
            Logotipo embutido no HTML, e não <img src>: evita uma requisição em todas as páginas,
            fica nítido em qualquer tela e não pisca antes de carregar. aria-hidden porque o nome
            já está no aria-label do link — um leitor de tela anunciaria "brpdf" duas vezes.
          */}
          <span class="brand-logo" aria-hidden="true" set:html={LOGO} />
          <span class="brand-sub">PDF Jurídico</span>
        </a>
        <nav class="site-nav" aria-label="Principal">
          {LINKS.map((l) => (
            <a
              href={l.href}
              aria-current={l.match ? current(l.match) : undefined}
              data-open-tool={l.tool ?? undefined}
              data-go-home={l.home ? '' : undefined}
            >
              {l.label}
            </a>
          ))}
        </nav>
        <a class="btn header-cta" href="/?view=tool" data-open-tool="cabecalho">Preparar PDFs</a>
        <details class="nav-toggle">
          <summary aria-label="Abrir o menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
          </summary>
          <nav class="panel" aria-label="Menu">
            {LINKS.map((l) => (
              <a
                href={l.href}
                aria-current={l.match ? current(l.match) : undefined}
                data-open-tool={l.tool ? 'menu_celular' : undefined}
                data-go-home={l.home ? '' : undefined}
              >
                {l.label}
              </a>
            ))}
          </nav>
        </details>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="inner">
        <nav aria-label="Rodapé" class="rodape-ferramentas">
          <a href="/comprimir-pdf/">Comprimir PDF</a>
          <a href="/dividir-pdf/">Dividir PDF</a>
          <a href="/juntar-pdf/">Juntar PDFs</a>
          <a href="/verificar-assinatura-digital/">Verificar assinatura</a>
          <a href="/metadados-pdf/">Raio-X do PDF</a>
          <a href="/documento-feito-por-ia/">Documento feito por IA</a>
          <a href="/sistemas/">Limites por sistema</a>
          <a href="/tribunais/">Limites por tribunal</a>
          <a href="/guias/">Guias</a>
        </nav>
        {/*
          Três guias no rodapé, e não os 22. Link de rodapé repetido em todas as páginas é
          boilerplate: o buscador desconta, e uma lista que cresce todo dia (há rotina criando
          guias) deixaria o rodapé ilegível. O peso de verdade vem dos blocos contextuais nas
          páginas de tribunal e no fim de cada guia, onde o link tem motivo escrito ao lado.
          Aqui ficam só as três portas de entrada de maior intenção de busca.
        */}
        <nav aria-label="Guias mais procurados" class="rodape-guias">
          <a href="/guias/o-sistema-recusou-meu-pdf-causas-e-solucoes/">O sistema recusou meu PDF</a>
          <a href="/guias/limite-por-arquivo-pagina-e-peticao/">Limite por arquivo, página e petição</a>
          <a href="/guias/checklist-antes-de-protocolar-anexos-em-pdf/">Checklist antes de protocolar</a>
        </nav>
        <nav aria-label="Rodapé">
          <a href="/seguranca/">Segurança</a>
          <a href="/privacidade/">Privacidade</a>
          <a href="/termos/">Termos de uso</a>
          <a href="/metodologia/">Metodologia</a>
          <a href="/contato/">Contato</a>
        </nav>
        <p>
          O {SITE.name} é gratuito, independente e não possui vínculo com tribunais ou com o CNJ. Confira sempre o limite informado no sistema de
          peticionamento.
        </p>
        <p>
          Software livre AGPL-3.0 — <a href={SITE.repo} rel="noreferrer noopener" target="_blank">veja o código-fonte</a>.{' '}
          <a href="https://www.ghostscript.com/" rel="noreferrer noopener" target="_blank">Ghostscript</a> executado em
          WebAssembly no navegador.
        </p>
      </div>
    </footer>
    <script>
      // Medição de uso (contagens agregadas, sem dados de documento). Ver src/scripts/metricas.ts.
      import '../scripts/metricas'
    </script>
  </body>
</html>
