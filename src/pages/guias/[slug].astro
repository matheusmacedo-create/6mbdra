---
import Base from '../../layouts/Base.astro'
import { getCollection, render } from 'astro:content'
import { formatDate } from '../../tool/lib/format'
import { SITE } from '../../config/site'
import { relacionados } from '../../tool/lib/guias'

export async function getStaticPaths() {
  const guias = await getCollection('guias')
  return guias.map((g) => ({ params: { slug: g.id }, props: { guia: g, todos: guias } }))
}
const { guia, todos } = Astro.props
const proximos = relacionados(guia, todos)
const { Content } = await render(guia)
const updated = guia.data.updated.toISOString().slice(0, 10)

/*
 * Article + BreadcrumbList. "Article" e não "BlogPosting" porque isto é material de referência,
 * revisado e datado, não publicação cronológica. dateModified é a data real de revisão do guia.
 */
const dados = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: guia.data.title,
      description: guia.data.description,
      dateModified: guia.data.updated.toISOString(),
      inLanguage: 'pt-BR',
      isAccessibleForFree: true,
      mainEntityOfPage: new URL(`/guias/${guia.id}/`, SITE.url).href,
      publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
      about: guia.data.tags.map((t) => ({ '@type': 'Thing', name: t })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Guias', item: new URL('/guias/', SITE.url).href },
        { '@type': 'ListItem', position: 3, name: guia.data.title, item: new URL(`/guias/${guia.id}/`, SITE.url).href },
      ],
    },
  ],
}
---
<Base title={guia.data.titleSeo ?? guia.data.title} description={guia.data.description} path={`/guias/${guia.id}/`}>
  <Fragment slot="head"><script type="application/ld+json" is:inline set:html={JSON.stringify(dados)} /></Fragment>
  <main class="page prose">
    <p><a href="/guias/">← Todos os guias</a></p>
    <h1>{guia.data.title}</h1>
    <p class="lead">{guia.data.description}</p>
    <p><small>Atualizado em {formatDate(updated)}. {guia.data.tags.map((t) => <span class="tag">{t}</span>)}</small></p>
    <Content />
    {proximos.length > 0 && (
      <nav class="relacionados" aria-label="Guias relacionados">
        <h2>Continue por aqui</h2>
        <ul>
          {proximos.map((g) => (
            <li>
              <a href={`/guias/${g.id}/`}>{g.data.title}</a>
              <p>{g.data.description}</p>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <div class="callout">
      Precisa preparar PDFs agora? Use a <a href="/">ferramenta gratuita</a>: ela compacta e divide os arquivos no seu navegador, sem enviar nada.
    </div>
  </main>
</Base>
