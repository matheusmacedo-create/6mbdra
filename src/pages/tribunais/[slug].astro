---
import Base from '../../layouts/Base.astro'
import SeloSigilo from '../../layouts/SeloSigilo.astro'
import Vantagens from '../../layouts/Vantagens.astro'
import AvisoRegra from '../../layouts/AvisoRegra.astro'
import { contextoCurto, formatLimite, idPagina, limiteBytes, metaBytes, mostrarBytesDoLimite, paginasDeRegras, percentualMeta, regrasDoTribunal, rotuloContexto, rotuloSistema, sistemaCurto, slugSistema, tituloRegraDoTribunal, type RegraDoTribunal } from '../../tool/lib/regras'
import { sistemaPorSlug } from '../../tool/lib/sistemas'
import { alvoDoTribunal, guiasDoTribunal } from '../../tool/lib/guias'
import { ALVOS } from '../../data/tamanhosAlvo'
import { getCollection } from 'astro:content'
import { formatBytes, formatDate } from '../../tool/lib/format'
import { SITE } from '../../config/site'

export function getStaticPaths() {
  return paginasDeRegras().map((x) => ({ params: { slug: idPagina(x) }, props: { pagina: x } }))
}
const { pagina } = Astro.props as { pagina: RegraDoTribunal }
const { regra, tribunal, herdada } = pagina
const sigla = tribunal.sigla
const contexto = rotuloContexto(regra)
const titulo = tituloRegraDoTribunal(pagina)
const outras = regrasDoTribunal(sigla).filter((x) => idPagina(x) !== idPagina(pagina))
const linkFerramenta = herdada ? `/?regra=${regra.id}&tribunal=${encodeURIComponent(sigla)}` : `/?regra=${regra.id}`
/** Existe página do sistema? (sistemas de um tribunal só não têm) */
const paginaDoSistema = sistemaPorSlug(slugSistema(regra))

/*
 * Guias que interessam a QUEM PROTOCOLA NESTE tribunal. A seleção vem dos dados desta regra, então
 * tribunal com limite apertado, com exigência de PDF/A ou com limite por página recebe lista
 * diferente. Antes disto, nenhuma das 101 páginas de tribunal apontava para guia nenhum — 73% do
 * site sem passar nada para o conteúdo.
 */
const guiasDaqui = guiasDoTribunal(
  {
    id: regra.id,
    limiteMb: limiteBytes(regra) / 1_000_000,
    exigePdfa: regra.exige_pdfa,
    limitePorPaginaKb: regra.limite_por_pagina_kb,
    limiteTotalPeticaoMb: regra.limite_total_peticao_mb,
  },
  await getCollection('guias'),
)

/** Página de "comprimir para X" que bate exatamente com o teto daqui (ou com esta regra). */
const alvoDaqui = alvoDoTribunal(regra.id, limiteBytes(regra) / 1_000_000, ALVOS)

/*
 * Perguntas frequentes desta regra. Todas as respostas saem dos dados do próprio tribunal, então
 * cada página tem conteúdo diferente — o oposto de repetir o mesmo bloco em 107 páginas, que seria
 * conteúdo duplicado. Servem para dois públicos ao mesmo tempo: quem lê e o buscador, que pode
 * usá-las como resposta direta.
 */
const PERGUNTAS: { q: string; a: string }[] = [
  {
    q: `Qual o tamanho máximo de PDF no ${sistemaCurto(regra)} do ${sigla}?`,
    a: `${formatLimite(regra)} por arquivo${contexto ? ` (${contexto})` : ''}. Valor conferido em ${formatDate(regra.verificado_em)} na fonte oficial do tribunal. Confira também na tela de anexar antes de protocolar: regra muda sem aviso.`,
  },
  {
    q: `O que fazer se o PDF passar de ${formatLimite(regra)}?`,
    a: `Comprima o arquivo até abaixo do limite; se nem a compressão mais forte couber, divida em partes por páginas inteiras. O brpdf faz as duas coisas no navegador, de graça e sem enviar o documento para nenhum servidor.`,
  },
  ...(regra.limite_por_pagina_kb
    ? [{
        q: `O ${sigla} tem limite por página?`,
        a: `Sim: ${regra.limite_por_pagina_kb} KB por página, além do limite de ${formatLimite(regra)} por arquivo. Documento curto e pesado é o que mais sofre com esse limite — uma digitalização colorida de três páginas pode passar dele mesmo cabendo no limite por arquivo.`,
      }]
    : []),
  ...(regra.limite_total_peticao_mb
    ? [{
        q: `Existe limite para a soma dos anexos de uma petição no ${sigla}?`,
        a: `Sim: ${regra.limite_total_peticao_mb} MB no conjunto. Cada arquivo pode estar dentro do limite individual e a petição ainda ser recusada pela soma. Nesse caso, ou os arquivos são reduzidos mais, ou o protocolo é dividido em mais de uma petição.`,
      }]
    : []),
  ...(regra.exige_pdfa
    ? [{
        q: `O ${sigla} exige PDF/A?`,
        a: `Sim, na petição inicial. Converta para PDF/A depois de comprimir e antes de assinar: comprimir depois da conversão pode quebrar a conformidade, e qualquer alteração depois da assinatura a invalida.`,
      }]
    : []),
  {
    q: `Comprimir o PDF atrapalha a assinatura digital ou o texto pesquisável?`,
    a: `O texto continua: a compressão reduz as imagens, não a camada de texto, então a busca por palavra segue funcionando. A assinatura digital, ao contrário, não sobrevive a nenhuma alteração — por isso comprima antes de assinar, nunca depois.`,
  },
]

const dadosEstruturados = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: SITE.url },
        { '@type': 'ListItem', position: 2, name: 'Tribunais', item: new URL('/tribunais/', SITE.url).href },
        { '@type': 'ListItem', position: 3, name: titulo, item: new URL(`/tribunais/${idPagina(pagina)}/`, SITE.url).href },
      ],
    },
    { '@type': 'FAQPage', mainEntity: PERGUNTAS.map((p) => ({ '@type': 'Question', name: p.q, acceptedAnswer: { '@type': 'Answer', text: p.a } })) },
  ],
}
---
<Base
  title={titulo}
  description={`${sigla}: cada PDF anexado no ${sistemaCurto(regra)}${contextoCurto(regra) ? ` (${contextoCurto(regra)})` : ''} pode ter até ${formatLimite(regra)}. Fonte oficial, data da conferência e a meta segura.`}
  path={`/tribunais/${idPagina(pagina)}/`}
>
  <Fragment slot="head"><script type="application/ld+json" is:inline set:html={JSON.stringify(dadosEstruturados)} /></Fragment>
  <main class="page prose">
    <p><a href="/tribunais/">← Todos os tribunais</a></p>
    <h1>{titulo}</h1>
    {/*
      O "lead" desta página era `{tribunal.nome} · {contexto}` — metadado, não frase. Quem chega
      aqui digitou "limite de anexo no PJe do TJxx" com um arquivo grande na mão e uma dúvida de um
      minuto: cabe ou não cabe? Repetir o nome do tribunal que ele acabou de ler no título não
      responde nada, e empurra a resposta para depois de uma tabela.

      Agora a primeira linha DÁ o número, e a segunda oferece a saída. São 101 páginas: é a mudança
      de copy com mais alcance do site.
    */}
    <p class="lead">
      No {rotuloSistema(regra)} do {sigla}, cada PDF anexado pode ter até <strong>{formatLimite(regra)}</strong>.
      {contexto ? ` ${contexto}.` : ''}
    </p>
    <p class="lead-acao">
      Seu arquivo passou disso? Prepare em segundos, com este limite já selecionado — <strong>grátis, sem cadastro</strong>, e o documento não sai
      do seu computador.
    </p>
    <p><a class="cta" href={linkFerramenta}>Preparar meus PDFs para o {sigla}</a></p>
    <Vantagens />
    {paginaDoSistema && (
      <p>
        Outros tribunais no {paginaDoSistema.nome}: veja o <a href={`/sistemas/${paginaDoSistema.slug}/`}>limite do {paginaDoSistema.nome} em
        {' '}{paginaDoSistema.tribunais.length} tribunais</a>.
      </p>
    )}
    {herdada && (
      <div class="callout">
        Regra nacional: o limite abaixo é definido pelo {regra.tribunal_sigla} ({regra.tribunal_nome}) e vale para o {rotuloSistema(regra)} do {sigla}.
      </div>
    )}

    <table>
      <tbody>
        <tr><th>Limite declarado</th><td>{formatLimite(regra)}{mostrarBytesDoLimite(regra) ? ` (${formatBytes(limiteBytes(regra))})` : ''} · lemos MB como 1.000.000 bytes</td></tr>
        <tr><th>Meta segura usada pela ferramenta</th><td>{formatBytes(metaBytes(regra))} ({percentualMeta(regra)}% do limite)</td></tr>
        {regra.limite_por_pagina_kb && <tr><th>Limite por página</th><td>{regra.limite_por_pagina_kb} KB por página (a ferramenta ajusta a meta de cada arquivo pelo número de páginas)</td></tr>}
        {regra.limite_total_peticao_mb && <tr><th>Limite por petição</th><td>{regra.limite_total_peticao_mb} MB na soma dos arquivos de uma petição</td></tr>}
        {regra.limite_condicional && <tr><th>Limite condicional</th><td>{regra.limite_condicional.limite_valor} {regra.limite_condicional.limite_unidade} para arquivos com {regra.limite_condicional.min_paginas} páginas ou mais</td></tr>}
        <tr><th>Formato</th><td>{regra.formato}{regra.exige_pdfa ? ' (exige PDF/A na petição inicial)' : ''}</td></tr>
        <tr><th>Fonte oficial</th><td><a href={regra.fonte_url} rel="noreferrer noopener" target="_blank">{regra.fonte_titulo}</a>{regra.data_fonte ? ` (publicada em ${formatDate(regra.data_fonte)})` : ''}</td></tr>
        <tr><th>Última conferência</th><td>{formatDate(regra.verificado_em)}</td></tr>
        {regra.situacao === 'em_revisao' && <tr><th>Situação</th><td>Em revisão — {regra.motivo_revisao}</td></tr>}
      </tbody>
    </table>

    {regra.fonte_trecho && (
      <>
        <h2>O que a fonte diz</h2>
        <blockquote>{regra.fonte_trecho}</blockquote>
      </>
    )}
    {regra.observacoes && (
      <>
        <h2>Observações</h2>
        <p>{regra.observacoes}</p>
      </>
    )}

    <h2>Como deixar seus PDFs dentro desse limite</h2>
    <p>
      A ferramenta abre com esta regra já selecionada: arraste os PDFs, e cada um volta abaixo de {formatBytes(metaBytes(regra))} — a margem segura
      que usamos para o limite de {formatLimite(regra)}. O que não couber nem comprimido é dividido em partes numeradas, sem cortar página no meio.
    </p>
    <p>
      Documento assinado digitalmente fica de fora por padrão, porque comprimir quebraria a assinatura. Se quiser conferir um arquivo assinado antes
      de protocolar, use o <a href="/verificar-assinatura-digital/">verificador de assinatura</a>.
    </p>
    <p><a class="cta" href={linkFerramenta}>Preparar PDFs para o {rotuloSistema(regra)} do {sigla}</a></p>
    <SeloSigilo />

    {/*
      Depois de tudo que a pessoa veio buscar, e antes do aviso de que o limite pode mudar — que é
      exatamente o gancho da oferta. Não é coincidência de posição: o parágrafo seguinte diz "o
      limite pode ter mudado depois da nossa conferência", e este bloco é a resposta para isso.
    */}
    <AvisoRegra regra={regra.id} rotulo={`o ${rotuloSistema(regra)} do ${sigla}`} origem="tribunal" />

    <div class="callout warn">
      Este site não é oficial nem vinculado ao {sigla}. O limite pode ter mudado depois da nossa conferência: em caso de dúvida, vale o que o
      sistema mostra na tela de anexar documentos. Achou uma divergência? <a href="/contato/">Avise a gente</a>.
    </div>

    <h2>Perguntas frequentes</h2>
    <div class="faq-list">
      {PERGUNTAS.map((p) => (<details><summary>{p.q}</summary><p>{p.a}</p></details>))}
    </div>

    {guiasDaqui.length > 0 && (
      <>
        <h2>Como preparar o PDF para o {sigla}</h2>
        <ul class="guias-do-tribunal">
          {alvoDaqui && (
            <li>
              <a href={`/comprimir-pdf-para-${alvoDaqui.slug}/`}>Comprimir PDF para {alvoDaqui.rotulo}</a>
              <p>a meta de {alvoDaqui.rotulo} é exatamente o limite daqui — o que cabe nela e o que não cabe</p>
            </li>
          )}
          {guiasDaqui.map(({ guia, motivo }) => (
            <li>
              <a href={`/guias/${guia.id}/`}>{guia.data.title}</a>
              <p>{motivo}</p>
            </li>
          ))}
        </ul>
      </>
    )}

    {outras.length > 0 && (
      <>
        <h2>Outras regras do {sigla}</h2>
        <ul>{outras.map((x) => <li><a href={`/tribunais/${idPagina(x)}/`}>{rotuloSistema(x.regra)} · {formatLimite(x.regra)}{rotuloContexto(x.regra) ? ` (${rotuloContexto(x.regra)})` : ''}{x.herdada ? ' · regra nacional' : ''}</a></li>)}</ul>
      </>
    )}
  </main>
</Base>
