---
import Base from '../../layouts/Base.astro'
import { formatLimite, idPagina, limiteBytes, metaBytes, mostrarBytesDoLimite, paginasDeRegras, percentualMeta, regrasDoTribunal, rotuloContexto, rotuloSistema, slugSistema, tituloRegraDoTribunal, type RegraDoTribunal } from '../../tool/lib/regras'
import { sistemaPorSlug } from '../../tool/lib/sistemas'
import { formatBytes, formatDate } from '../../tool/lib/format'

export function getStaticPaths() {
  return paginasDeRegras().map((x) => ({ params: { slug: idPagina(x) }, props: { pagina: x } }))
}
const { pagina } = Astro.props as { pagina: RegraDoTribunal }
const { regra, tribunal, herdada } = pagina
const sigla = tribunal.sigla
const contexto = rotuloContexto(regra)
const titulo = tituloRegraDoTribunal(pagina)
const outras = regrasDoTribunal(sigla).filter((x) => idPagina(x) !== idPagina(pagina))
const linkFerramenta = herdada ? `/?regra=${regra.id}&tribunal=${encodeURIComponent(sigla)}` : `/?regra=${regra.id}`
/** Existe página do sistema? (sistemas de um tribunal só não têm) */
const paginaDoSistema = sistemaPorSlug(slugSistema(regra))
---
<Base
  title={titulo}
  description={`${tribunal.nome}: cada PDF anexado no ${rotuloSistema(regra)}${contexto ? ` (${contexto})` : ''} pode ter até ${formatLimite(regra)}. Fonte oficial, data de verificação e meta segura para não ter o arquivo recusado.`}
  path={`/tribunais/${idPagina(pagina)}/`}
>
  <main class="page prose">
    <p><a href="/tribunais/">← Todos os tribunais</a></p>
    <h1>{titulo}</h1>
    <p class="lead">{tribunal.nome}{contexto ? ` · ${contexto}` : ''}</p>
    {paginaDoSistema && (
      <p>
        Outros tribunais no {paginaDoSistema.nome}: veja o <a href={`/sistemas/${paginaDoSistema.slug}/`}>limite do {paginaDoSistema.nome} em
        {' '}{paginaDoSistema.tribunais.length} tribunais</a>.
      </p>
    )}
    {herdada && (
      <div class="callout">
        Regra nacional: o limite abaixo é definido pelo {regra.tribunal_sigla} ({regra.tribunal_nome}) e vale para o {rotuloSistema(regra)} do {sigla}.
      </div>
    )}

    <table>
      <tbody>
        <tr><th>Limite declarado</th><td>{formatLimite(regra)}{mostrarBytesDoLimite(regra) ? ` (${formatBytes(limiteBytes(regra))})` : ''} · lemos MB como 1.000.000 bytes</td></tr>
        <tr><th>Meta segura usada pela ferramenta</th><td>{formatBytes(metaBytes(regra))} ({percentualMeta(regra)}% do limite)</td></tr>
        {regra.limite_por_pagina_kb && <tr><th>Limite por página</th><td>{regra.limite_por_pagina_kb} KB por página (a ferramenta ajusta a meta de cada arquivo pelo número de páginas)</td></tr>}
        {regra.limite_total_peticao_mb && <tr><th>Limite por petição</th><td>{regra.limite_total_peticao_mb} MB na soma dos arquivos de uma petição</td></tr>}
        {regra.limite_condicional && <tr><th>Limite condicional</th><td>{regra.limite_condicional.limite_valor} {regra.limite_condicional.limite_unidade} para arquivos com {regra.limite_condicional.min_paginas} páginas ou mais</td></tr>}
        <tr><th>Formato</th><td>{regra.formato}{regra.exige_pdfa ? ' (exige PDF/A na petição inicial)' : ''}</td></tr>
        <tr><th>Fonte oficial</th><td><a href={regra.fonte_url} rel="noreferrer noopener" target="_blank">{regra.fonte_titulo}</a>{regra.data_fonte ? ` (publicada em ${formatDate(regra.data_fonte)})` : ''}</td></tr>
        <tr><th>Última conferência</th><td>{formatDate(regra.verificado_em)}</td></tr>
        {regra.situacao === 'em_revisao' && <tr><th>Situação</th><td>Em revisão — {regra.motivo_revisao}</td></tr>}
      </tbody>
    </table>

    {regra.fonte_trecho && (
      <>
        <h2>O que a fonte diz</h2>
        <blockquote>{regra.fonte_trecho}</blockquote>
      </>
    )}
    {regra.observacoes && (
      <>
        <h2>Observações</h2>
        <p>{regra.observacoes}</p>
      </>
    )}

    <h2>Como deixar seus PDFs dentro desse limite</h2>
    <p>
      Abra a ferramenta com esta regra já selecionada, arraste os PDFs e baixe os arquivos preparados. Tudo roda no seu navegador; nenhum documento é
      enviado para a internet.
    </p>
    <p><a class="cta" href={linkFerramenta}>Preparar PDFs para o {rotuloSistema(regra)} do {sigla}</a></p>

    <div class="callout warn">
      Este site não é oficial nem vinculado ao {sigla}. O limite pode ter mudado depois da nossa conferência: em caso de dúvida, vale o que o
      sistema mostra na tela de anexar documentos. Achou uma divergência? <a href="/contato/">Avise a gente</a>.
    </div>

    {outras.length > 0 && (
      <>
        <h2>Outras regras do {sigla}</h2>
        <ul>{outras.map((x) => <li><a href={`/tribunais/${idPagina(x)}/`}>{rotuloSistema(x.regra)} · {formatLimite(x.regra)}{rotuloContexto(x.regra) ? ` (${rotuloContexto(x.regra)})` : ''}{x.herdada ? ' · regra nacional' : ''}</a></li>)}</ul>
      </>
    )}
  </main>
</Base>
