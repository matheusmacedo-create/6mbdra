---
import Base from '../../layouts/Base.astro'
import { REGRAS, formatLimite, limiteBytes, metaBytes, type Regra } from '../../tool/lib/regras'
import { formatBytes, formatDate } from '../../tool/lib/format'

export function getStaticPaths() {
  return REGRAS.regras.map((r) => ({ params: { slug: r.id }, props: { regra: r } }))
}
const { regra } = Astro.props as { regra: Regra }
const ctx = (r: Regra) => [r.instancia, r.tipo_peticionamento].filter((x) => x && x !== 'não se aplica' && x !== 'geral').join(', ')
const contexto = ctx(regra)
const titulo = `Limite de PDF no ${regra.sistema} do ${regra.tribunal_sigla}: ${formatLimite(regra)}`
const outras = REGRAS.regras.filter((r) => r.tribunal_sigla === regra.tribunal_sigla && r.id !== regra.id)
---
<Base
  title={titulo}
  description={`${regra.tribunal_nome}: cada PDF anexado no ${regra.sistema}${contexto ? ` (${contexto})` : ''} pode ter até ${formatLimite(regra)}. Fonte oficial, data de verificação e meta segura para não ter o arquivo recusado.`}
  path={`/tribunais/${regra.id}/`}
>
  <main class="page prose">
    <p><a href="/tribunais/">← Todos os tribunais</a></p>
    <h1>{titulo}</h1>
    <p class="lead">{regra.tribunal_nome}{contexto ? ` · ${contexto}` : ''}</p>

    <table>
      <tbody>
        <tr><th>Limite declarado</th><td>{formatLimite(regra)} ({formatBytes(limiteBytes(regra))}, lendo MB como 1.000.000 bytes)</td></tr>
        <tr><th>Meta segura usada pela ferramenta</th><td>{formatBytes(metaBytes(regra))} ({regra.meta_segura_percentual ?? REGRAS.meta_segura_percentual_padrao}% do limite)</td></tr>
        <tr><th>Formato</th><td>{regra.formato}</td></tr>
        <tr><th>Fonte oficial</th><td><a href={regra.fonte_url} rel="noreferrer noopener" target="_blank">{regra.fonte_titulo}</a>{regra.data_fonte ? ` (publicada em ${formatDate(regra.data_fonte)})` : ''}</td></tr>
        <tr><th>Última conferência</th><td>{formatDate(regra.verificado_em)}{regra.situacao === 'em_revisao' ? ' — em revisão' : ''}</td></tr>
      </tbody>
    </table>

    {regra.fonte_trecho && (
      <>
        <h2>O que a fonte diz</h2>
        <blockquote>{regra.fonte_trecho}</blockquote>
      </>
    )}
    {regra.observacoes && (
      <>
        <h2>Observações</h2>
        <p>{regra.observacoes}</p>
      </>
    )}

    <h2>Como deixar seus PDFs dentro desse limite</h2>
    <p>
      Abra a ferramenta com esta regra já selecionada, arraste os PDFs e baixe os arquivos preparados. Tudo roda no seu navegador; nenhum documento é
      enviado para a internet.
    </p>
    <p><a class="cta" href={`/?regra=${regra.id}`}>Preparar PDFs para o {regra.sistema} do {regra.tribunal_sigla}</a></p>

    <div class="callout warn">
      Este site não é oficial nem vinculado ao {regra.tribunal_sigla}. O limite pode ter mudado depois da nossa conferência: em caso de dúvida, vale o
      que o sistema mostra na tela de anexar documentos. Achou uma divergência? <a href="/contato/">Avise a gente</a>.
    </div>

    {outras.length > 0 && (
      <>
        <h2>Outras regras do {regra.tribunal_sigla}</h2>
        <ul>{outras.map((r) => <li><a href={`/tribunais/${r.id}/`}>{r.sistema} · {formatLimite(r)}{ctx(r) ? ` (${ctx(r)})` : ''}</a></li>)}</ul>
      </>
    )}
  </main>
</Base>
