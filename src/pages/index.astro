---
import Base from '../layouts/Base.astro'
import App from '../tool/App'
import { TRIBUNAIS, tribunaisCobertos } from '../tool/lib/regras'
import { getCollection } from 'astro:content'
import { SITE } from '../config/site'

const cobertos = tribunaisCobertos().length
const guias = (await getCollection('guias')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'pt-BR')).slice(0, 4)

const ICONES: Record<string, string> = {
  comprimir: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v7"/><path d="m8 7 4 4 4-4"/><path d="M12 21v-7"/><path d="m8 17 4-4 4 4"/></svg>',
  dividir: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18"/><rect x="5" y="3" width="14" height="5" rx="1.5"/><rect x="5" y="16" width="14" height="5" rx="1.5"/></svg>',
  zip: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7.5 12 3l8 4.5v9L12 21l-8-4.5z"/><path d="M12 3v18"/><path d="m4 7.5 8 4.5 8-4.5"/></svg>',
  selo: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v5.5c0 4.4 3.1 8.3 8 9.5 4.9-1.2 8-5.1 8-9.5V6z"/><path d="m9 12 2 2 4-4"/></svg>',
  lupa: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/><path d="M11 8v6M8 11h6"/></svg>',
  juntar: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="10" height="13" rx="2"/><path d="M17 8h2a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-6a2 2 0 0 1-2-2v-1"/></svg>',
  paginas: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><path d="M14 17.5h7M17.5 14v7"/></svg>',
  check: '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m20 6-11 11-5-5"/></svg>',
  favorito: '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h12a1 1 0 0 1 1 1v15l-7-4-7 4V5a1 1 0 0 1 1-1z"/></svg>',
}
const icone = (k: string) => ICONES[k] ?? ''

const FERRAMENTAS = [
  {
    icone: 'comprimir',
    cor: 'blue',
    title: 'Compactar para o tribunal',
    desc: 'Reduza o tamanho dos anexos com uma meta em MB ou uma regra cadastrada do tribunal.',
    status: 'Disponível',
    cta: 'Compactar agora',
  },
  {
    icone: 'dividir',
    cor: 'green',
    title: 'Dividir PDFs grandes',
    desc: 'Separe arquivos grandes em partes numeradas, sem cortar páginas ao meio.',
    status: 'Disponível',
    cta: 'Dividir PDF',
  },
  {
    icone: 'zip',
    cor: 'purple',
    title: 'Preparar lote em ZIP',
    desc: 'Baixe tudo em ordem, com nomes padronizados e um resumo para facilitar o protocolo.',
    status: 'Disponível',
    cta: 'Preparar lote',
  },
  {
    icone: 'selo',
    cor: 'green',
    title: 'Verificar assinatura digital',
    desc: 'Descubra se o PDF assinado continua íntegro ou se foi alterado depois de assinado.',
    status: 'Disponível',
    cta: 'Verificar assinatura',
    href: '/conferir-assinatura/',
  },
  {
    icone: 'lupa',
    cor: 'purple',
    title: 'Raio-X do PDF',
    desc: 'Consulte autor, datas e outras informações registradas nos metadados do documento.',
    status: 'Disponível',
    cta: 'Abrir o Raio-X',
    href: '/metadados-pdf/',
  },
  {
    icone: 'lupa',
    cor: 'red',
    title: 'Consultar origem do arquivo',
    desc: 'Confira registros de origem e declarações sobre IA, quando disponíveis no arquivo.',
    status: 'Disponível',
    cta: 'Ver a origem',
    href: '/documento-feito-por-ia/',
  },
  { icone: 'juntar', cor: 'yellow', title: 'Juntar PDFs', desc: 'Una procurações, contratos e anexos na ordem desejada antes de protocolar.', status: 'Em breve' },
  { icone: 'paginas', cor: 'red', title: 'Organizar páginas', desc: 'Reordene, remova ou gire páginas de documentos digitalizados em poucos cliques.', status: 'Em breve' },
]

const PASSOS = [
  { n: '01', t: 'Selecione os PDFs', d: 'Arraste vários documentos ou uma pasta inteira de uma vez.' },
  { n: '02', t: 'Escolha o tribunal', d: 'Informe o sistema ou use um limite personalizado em MB.' },
  { n: '03', t: 'Confira e baixe', d: 'Revise o resultado e baixe os documentos em um ZIP organizado.' },
]

const PERGUNTAS = [
  { q: 'Meus documentos são enviados para algum servidor?', a: 'Não. Todo o processamento acontece no navegador e nenhum PDF é enviado para a internet.' },
  { q: 'O texto continua pesquisável?', a: 'Sim. A ferramenta preserva texto, fontes e a camada de OCR durante a compressão.' },
  { q: 'E se o PDF não couber mesmo comprimido?', a: 'Com a divisão automática ativada, o arquivo é separado em partes numeradas sem cortar páginas.' },
  { q: 'Posso preparar vários arquivos de uma vez?', a: 'Sim. Selecione vários PDFs ou arraste uma pasta e baixe o lote em um único ZIP organizado.' },
  { q: 'Existe cobrança, cadastro ou limite diário?', a: 'Não. O brpdf é gratuito, não exige conta e pode ser utilizado quantas vezes o escritório precisar.' },
]

const SEGURANCA = [
  { t: 'Processamento local', d: 'A preparação dos PDFs acontece no seu próprio dispositivo.' },
  { t: 'Texto e OCR preservados', d: 'O conteúdo pesquisável continua disponível no arquivo final.' },
  { t: 'Sem cadastro', d: 'Nenhuma conta, e-mail ou assinatura para começar.' },
]
const dadosEstruturados = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'brpdf · PDF Jurídico',
      url: SITE.url,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Navegador (Chrome, Edge, Firefox, Safari)',
      inLanguage: 'pt-BR',
      isAccessibleForFree: true,
      description:
        'Comprima, divida e organize PDFs para PJe, eproc, e-SAJ e Projudi. Gratuito, sem cadastro e sem enviar documentos para a internet.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'BRL' },
      license: 'https://www.gnu.org/licenses/agpl-3.0.html',
      codeRepository: SITE.repo,
      featureList: [
        'Compressão de PDF até o limite do tribunal',
        'Divisão automática em partes por páginas inteiras',
        'Lote em ZIP com nomes padronizados',
        'Processamento local, sem envio de arquivos',
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: PERGUNTAS.map((p) => ({
        '@type': 'Question',
        name: p.q,
        acceptedAnswer: { '@type': 'Answer', text: p.a },
      })),
    },
  ],
}
---
<Base
  title="PDF pronto para protocolar"
  description="Comprima, divida e organize PDFs para PJe, eproc, e-SAJ e Projudi. Gratuito, sem cadastro e sem enviar documentos para a internet."
  path="/"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(dadosEstruturados)} />
  </Fragment>
  <main class="home-refresh">
    <section class="hero-band">
      <div class="wrap hero">
        <div class="hero-content home-only">
          <p class="eyebrow">Seu PDF. Seu prazo. Tudo mais simples.</p>
          <h1 class="hero-title">Menos tempo no PDF.<br /><span>Mais tempo no processo.</span></h1>
          <p class="hero-description">
            Compacte e divida seus PDFs para o limite do tribunal.<br class="desktop-break" /> Grátis, sem cadastro e com os arquivos no seu dispositivo.
          </p>
        </div>
        {/*
          * A ilha React só existe depois de hidratar. Sem altura reservada, o herói se recentraliza
          * quando ela monta e isso conta como deslocamento de layout (CLS), que é fator de
          * ranqueamento. A altura corresponde à área de upload + linha de confiança + etapa.
          */}
        <div class="ilha-ferramenta"><App client:only="react" /></div>
      </div>
    </section>

    <section class="trust-bar home-only" aria-label="Resumo do serviço">
      <ul class="wrap">
        <li><Fragment set:html={icone('check')} />Uso gratuito</li>
        <li><Fragment set:html={icone('check')} />{cobertos} tribunais mapeados</li>
        <li><Fragment set:html={icone('check')} />Processamento no navegador</li>
        <li><Fragment set:html={icone('check')} />Texto pesquisável preservado</li>
      </ul>
    </section>

    <section class="wrap home-section home-only" id="ferramentas">
      <div class="section-head">
        <h2>O que você precisa resolver agora?</h2>
        <p>Ferramentas gratuitas para os documentos do seu dia a dia.</p>
      </div>
      <ul class="tools-grid">
        {FERRAMENTAS.filter((f) => f.cta).map((f) =>
          f.cta ? (
            <li>
              <a class="tool-card" href={f.href ?? '/?view=tool'} data-open-tool={f.href ? undefined : 'card'}>
                <span class={`mark ${f.cor}`} aria-hidden="true" set:html={icone(f.icone)} />
                <span class="title">{f.title}</span>
                <span class="desc">{f.desc}</span>
                
                <span class="card-cta">{f.cta} →</span>
              </a>
            </li>
          ) : (
            <li>
              <div class="tool-card soon">
                <span class={`mark ${f.cor}`} aria-hidden="true" set:html={icone(f.icone)} />
                <span class="title">{f.title}</span>
                <span class="desc">{f.desc}</span>
                <span class="status"><span class="pill soon">{f.status}</span></span>
              </div>
            </li>
          ),
        )}
      </ul>
      <p class="mais-sobre">
        Como cada uma funciona: <a href="/comprimir-pdf/">comprimir PDF</a> · <a href="/dividir-pdf/">dividir por tamanho</a> ·{' '}
        <a href="/juntar-pdf/">juntar em um só</a> · <a href="/conferir-assinatura/">verificar assinatura</a> ·{' '}
        <a href="/metadados-pdf/">raio-X do PDF</a> ·{' '}
        <a href="/documento-feito-por-ia/">origem por IA</a> · <a href="/sistemas/">limites por sistema</a>
      </p>
    </section>

    <section class="wrap home-section home-only" id="como-funciona">
      <div class="section-head">
        <h2>Do arquivo pesado ao próximo passo.</h2>
        <p>Selecione os documentos, escolha o limite e baixe o resultado. Simples assim.</p>
      </div>
      <ol class="steps">
        {PASSOS.map((p) => (
          <li class="step-card">
            <span class="n">{p.n}</span>
            <span class="t">{p.t}</span>
            <span class="d">{p.d}</span>
          </li>
        ))}
      </ol>
    </section>

    <div class="wrap home-only"><div class="ad-slot" data-enabled="false" aria-hidden="true"></div></div>

    <section class="band-soft home-only" id="seguranca">
      <div class="wrap security">
        <div class="section-head">
          <p class="eyebrow">Sigilo em primeiro lugar</p>
          <h2>O documento é confidencial.<br />E continua com você.</h2>
          <p>
            A preparação acontece dentro do seu navegador. Arquivos, nomes de documentos e números de processo não são enviados para o brpdf.
          </p>
        </div>
        <ul class="security-grid">
          {SEGURANCA.map((s) => (
            <li>
              <span class="t">{s.t}</span>
              <span class="d">{s.d}</span>
            </li>
          ))}
        </ul>
        <a class="btn" href="/seguranca/">Entenda como seus arquivos são protegidos</a>
      </div>
    </section>

    <section class="wrap home-section home-only">
      <div class="courts-card">
        <div>
          <h2>Cada tribunal tem um limite. Encontre o seu.</h2>
          <p>
            Consulte PJe, eproc, e-SAJ e Projudi por tribunal, instância e tipo de petição. Cada regra mostra a fonte oficial e a data da última
            conferência.
          </p>
          <span class="highlight">{cobertos} de {TRIBUNAIS.length} tribunais com regra cadastrada</span>
        </div>
        <a class="btn" href="/tribunais/">Consultar tribunais</a>
      </div>
    </section>

    <section class="wrap home-only return-strip" aria-label="Acesso rápido">
      <div><strong>Sua próxima petição também pode dar menos trabalho.</strong><p>Salve o brpdf nos favoritos e tenha suas ferramentas sempre à mão.</p></div>
      <a class="btn" href="/?view=tool" data-open-tool="favoritos">Preparar meus PDFs →</a>
    </section>

    <section class="wrap home-section home-only faq" id="perguntas">
      <div class="section-head"><h2>Perguntas frequentes</h2></div>
      <div class="faq-list">
        {PERGUNTAS.map((p, i) => (
          <details data-faq={i + 1}>
            <summary>{p.q}</summary>
            <p>{p.a}</p>
          </details>
        ))}
      </div>
    </section>

    {guias.length > 0 && (
      <section class="wrap home-section home-only guias">
        <div class="section-head">
          <h2>Guias</h2>
          <p>Como digitalizar, dividir, nomear e conferir antes de protocolar.</p>
        </div>
        <ul class="grid-cards">
          {guias.map((g) => (
            <li>
              <a href={`/guias/${g.id}/`}>{g.data.title}</a>
              <p>{g.data.description}</p>
            </li>
          ))}
        </ul>
        <p class="more"><a href="/guias/">Ver todos os guias →</a></p>
      </section>
    )}
  </main>
</Base>

<script>
  // Evita o "piscar" das seções institucionais quando a URL já pede a ferramenta.
  if (/[?&](view=tool|regra=)/.test(location.search)) document.documentElement.dataset.view = 'tool'
</script>

<style>
  .courts-card h2 { margin: 0 0 8px; font-size: 26px; font-weight: 800; letter-spacing: -0.6px; }
  .courts-card p { margin: 0; color: var(--muted); font-size: 16.5px; }
  .faq-list { max-width: 760px; }
  .guias { padding-bottom: 56px; }
  .more { margin-top: 16px; }
</style>

<style is:global>
  /* Landing styles are scoped so the PDF workspace and other tools keep their layout. */
  .home-refresh { background: #fff; }
  .home-refresh .hero-band { background: radial-gradient(ellipse at 50% 0%, #eaf2ff 0%, #f8faff 52%, #fff 100%); }
  .home-refresh .hero { padding-top: 48px; padding-bottom: 32px; min-height: 0; }
  .home-refresh .hero-title { max-width: 900px; font-size: clamp(2.25rem, 4.5vw, 3.75rem); line-height: 1.1; letter-spacing: -.055em; }
  .home-refresh .hero-title span { color: var(--accent); }
  .home-refresh .eyebrow { letter-spacing: .08em; font-size: 11px; }
  .home-refresh .hero-description { margin-top: 18px; font-size: 17px; color: var(--ink-3); }
  .home-refresh .ilha-ferramenta { min-height: 340px; }
  .home-refresh .landing .dropzone.zone-hero { max-width: 640px; min-height: 220px; margin-top: 24px; padding: 22px; border: 1.5px dashed #9ab4d9; box-shadow: 0 12px 36px #0733810a; }
  .home-refresh .landing .icon-box { width: 42px; height: 42px; margin-bottom: 12px; border-radius: 12px; }
  .home-refresh .landing .upload-button { margin-bottom: 10px; box-shadow: 0 4px 10px #0733811a; }
  .home-refresh .landing .trust-line { margin-top: 16px; font-size: 13px; }
  .home-refresh .landing .step-hint { margin-top: 16px; font-size: 12px; font-weight: 500; }
  .home-refresh .trust-bar { background: #f8faff; }
  .home-refresh .trust-bar ul { padding-block: 20px; }
  .home-refresh .trust-bar li { font-size: 13px; }
  .home-refresh .home-section { padding-top: 68px; padding-bottom: 12px; }
  .home-refresh .section-head { max-width: 760px; }
  .home-refresh .section-head h2 { font-size: clamp(24px, 3vw, 32px); letter-spacing: -.035em; }
  .home-refresh .section-head p { font-size: 16px; }
  .home-refresh .tools-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .home-refresh .tool-card { padding: 26px; border-color: #e3e8f0; box-shadow: none; gap: 10px; transition: border-color .15s, box-shadow .15s; }
  .home-refresh a.tool-card:hover { text-decoration: none; border-color: #9ab4d9; box-shadow: 0 8px 24px #0733810b; }
  .home-refresh .tool-card .card-cta { margin-top: auto; padding-top: 14px; font-size: 14px; }
  .home-refresh .tool-card .title { font-size: 18px; }
  .home-refresh .tool-card .desc { font-size: 14px; }
  .home-refresh .mais-sobre { font-size: 13px; line-height: 1.8; }
  .home-refresh .step-card { padding: 22px 0 28px; border: 0; border-top: 2px solid #dae5f6; border-radius: 0; }
  .home-refresh .step-card .n { font-size: 28px; color: #6c89b4; }
  .home-refresh .band-soft { margin-top: 48px; background: #f3f6fb; border: 0; }
  .home-refresh .security-grid li { background: transparent; border: 0; border-left: 2px solid #c4d5ed; border-radius: 0; padding: 4px 20px; }
  .home-refresh .courts-card { box-shadow: none; padding: 32px; }
  .home-refresh .return-strip { margin-top: 48px; padding: 26px 32px; display: flex; gap: 24px; align-items: center; justify-content: space-between; border-block: 1px solid var(--border); }
  .home-refresh .return-strip strong { font-size: 18px; letter-spacing: -.02em; }
  .home-refresh .return-strip p { margin: 4px 0 0; font-size: 14px; color: var(--muted); }
  .home-refresh .return-strip .btn { flex-shrink: 0; }
  .home-refresh .faq-list { max-width: 900px; }
  html[data-view="tool"] .home-refresh .hero { padding: 0; }
  @media (max-width: 800px) {
    .home-refresh .tools-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .home-refresh .return-strip { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 560px) {
    .home-refresh .hero { padding: 32px 16px 24px; }
    .home-refresh .hero-title { font-size: 36px; }
    .home-refresh .hero-description { font-size: 15px; }
    .home-refresh .desktop-break { display: none; }
    .home-refresh .eyebrow { font-size: 10px; }
    .home-refresh .tools-grid { grid-template-columns: 1fr; }
    .home-refresh .home-section { padding-top: 44px; }
    .home-refresh .tool-card { padding: 22px; }
    .home-refresh .courts-card { padding: 22px; }
    .home-refresh .trust-bar ul { gap: 12px; }
    .home-refresh .trust-bar li { font-size: 12px; align-items: flex-start; }
    .home-refresh .return-strip { margin-top: 32px; padding: 24px 20px; }
  }
</style>
